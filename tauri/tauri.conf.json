{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "float",
  "version": "0.2.0",
  "identifier": "dev.float.lyrics",
  "build": {
    "frontendDist": "../ui/src",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": ".."
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "lyrics",
        "url": "index.html",
        "width": 320,
        "height": 318,
        "minWidth": 240,
        "minHeight": 240,
        "maxWidth": 560,
        "maxHeight": 560,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true,
        "focus": false,
        "visible": true,
        "visibleOnAllWorkspaces": true,
        "backgroundThrottling": "disabled",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "Floating synced lyrics for Spotify",
    "longDescription": "A floating, always-on-top mini player for macOS that shows line-synced lyrics (LRCLIB) for whatever is playing on Spotify.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
