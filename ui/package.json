{
  "name": "float-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --env-file=../.env build ts/main.ts --target=browser --format=esm --minify --env='SPOTIFY_*' --outdir=src/js",
    "watch": "bun --env-file=../.env build ts/main.ts --target=browser --format=esm --env='SPOTIFY_*' --outdir=src/js --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test ts"
  },
  "dependencies": {
    "@fabianlars/tauri-plugin-oauth": "2.1.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.5",
    "effect": "3.22.2",
    "@tauri-apps/plugin-sql": "2.4.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
